                </Grid>
            </TabItem>

            <!-- Tab 4: CPU Trigger -->
            <TabItem Header="CPU Trigger">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
